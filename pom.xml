pipeline {
    agent any

    tools {
        jdk 'JDK 11'
        maven 'Maven 3.8.1'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git 'https://github.com/aman-3701/ASPhones.git'
            }
        }

        stage('Build Project') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Run Project') {
            steps {
                sh 'java -jar target/ASPhones-0.0.1-SNAPSHOT.jar'
            }
        }
    }
}
